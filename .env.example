# Public browser-safe values, shared with the SvelteKit client.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only: never prefix these with PUBLIC_ and never enter them in browser forms.
OPENWEATHER_API_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Optional; defaults to PUBLIC_SUPABASE_URL on the server.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Enable only after checking Metro Cebu coverage, source metadata and reuse terms.
MGB_DATA_VERIFIED=false

# Optional live traffic for demo rooms. Simulation works without this key.
TOMTOM_API_KEY=
# Address search runs only on explicit submission. Use a single Node instance.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=FloodNav-Cebu-Demo/1.0 (interactive address search)
